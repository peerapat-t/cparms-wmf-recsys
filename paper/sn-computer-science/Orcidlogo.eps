%!PS-Adobe-3.0 EPSF-3.0
%%BoundingBox: 0 0 9 9
%%HiResBoundingBox: 0.000000 0.000000 9.000000 9.000000
%%Title: ORCID iD icon
%%Creator: ORCID iD icon (CC BY 4.0), redrawn for the sn-jnl template
%%LanguageLevel: 2
%%Pages: 1
%%EndComments
%%Page: 1 1
gsave

% --- green disc (ORCID green #A6CE39) ---
0.650980 0.807843 0.223529 setrgbcolor
4.5 4.5 4.5 0 360 arc
fill

% --- white "iD" wordmark, drawn as paths (no font dependency) ---
1 1 1 setrgbcolor

% dot of the "i"
2.30 6.45 0.52 0 360 arc
fill

% stem of the "i"
1.83 2.30 0.94 3.35 rectfill

% "D" outer bowl
newpath
3.55 2.30 moveto
5.05 2.30 lineto
6.62 2.30 7.55 3.30 7.55 4.55 curveto
7.55 5.80 6.62 6.80 5.05 6.80 curveto
3.55 6.80 lineto
closepath
fill

% "D" counter (punched out in green)
0.650980 0.807843 0.223529 setrgbcolor
newpath
4.49 3.24 moveto
4.98 3.24 lineto
5.98 3.24 6.55 3.80 6.55 4.55 curveto
6.55 5.30 5.98 5.86 4.98 5.86 curveto
4.49 5.86 lineto
closepath
fill

grestore
showpage
%%EOF
